{
 "schema": 2,
 "permissions": [
  "llm.complete",
  "storage.read",
  "storage.write",
  "tools.invoke"
 ],
 "host_capabilities": [
  "llm.complete",
  "aps.kv"
 ],
 "required_executas": [],
 "optional_executas": [],
 "ui": {
  "bundle": {
   "format": "static-spa",
   "entry": "index.html",
   "external_origins": [
    "https://open.er-api.com"
   ]
  },
  "views": [
   {
    "name": "main",
    "title": "Money Companion",
    "default": true,
    "entry": "index.html",
    "default_size": {
     "w": 1120,
     "h": 760
    },
    "min_size": {
     "w": 320,
     "h": 480
    },
    "max_size": {
     "w": 1600,
     "h": 1200
    },
    "resizable": true,
    "movable": true,
    "single_instance": true
   }
  ],
  "host_api": {
   "tools": [],
   "llm": [
    "complete"
   ],
   "storage": [
    "get",
    "set",
    "delete",
    "list"
   ],
   "window": [
    "ready"
   ],
   "mobile": [
    "share",
    "haptics",
    "camera_capture"
   ]
  },
  "form_factors": [
   "mobile"
  ]
 }
}
